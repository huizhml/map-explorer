# Copy this to ~/.litestream.env on hendrix and fill in real values.
# Permissions: chmod 600 ~/.litestream.env

# Cloudflare R2: endpoint format is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_BUCKET=map-explorer-saved-features
LITESTREAM_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY

# Backblaze B2 alternative (S3-compatible):
#   LITESTREAM_ENDPOINT=https://s3.<REGION>.backblazeb2.com
#   LITESTREAM_BUCKET=map-explorer-saved-features
#   LITESTREAM_ACCESS_KEY_ID=<keyID>
#   LITESTREAM_SECRET_ACCESS_KEY=<applicationKey>
