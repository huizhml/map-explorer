# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pyc
keys/

# User-generated state — never sync these into the deploy target, or remote rows
# get clobbered by the empty local placeholder on every sync.
backend/data/saved_features.db
backend/data/saved_features.db-*  # SQLite WAL / journal sidecars
.claude
.vscode
__pycache__
*.pyc
# Deployment state pulled from the internal host — never commit the DB or images.
deploy/data/*
!deploy/data/.gitkeep
# The MGRS/deploy-status grid is a build input, not user state: without it the
# frontend cannot work out which prediction tiles to request and the map stays
# blank. Tracked so a fresh clone can reproduce the deployment.
!deploy/data/s2_grid.fgb
deploy/hf-space/.space-repo/

# NOTE: public/examples/ is deliberately NOT ignored. The story's transect
# figures are produced by scripts/generate-transect-examples.mjs, which needs a
# running backend and takes minutes; the Pages workflow has neither. Same rule
# as deploy/data/s2_grid.fgb — if CI cannot regenerate it, it belongs in git.

# Full-resolution source art. Optimised copies live in public/; the originals
# would otherwise be published verbatim and are far too large to serve.
art/
