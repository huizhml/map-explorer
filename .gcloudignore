# Uploaded to Cloud Build on every deploy. Keep it to what the Dockerfile COPYs.
#
# NOTE: once this file exists, gcloud stops honouring .gitignore — so anything
# secret that .gitignore was protecting has to be repeated here.
.git/
.github/
.vscode/
.claude/
node_modules/
dist/
src/
public/
app/
scripts/
**/__pycache__/
*.pyc
deploy/hf-space/
*.html
test_*.py
.env*
keys/
*.log
# Local working data of the dev backend (saved-feature images, the local
# saved_features.db): 1.5 GB that `COPY backend/` would bake into the image.
# The container reads its state from deploy/data/ instead (entrypoint.sh).
backend/data/
# Prototypes and their downloaded data; nothing in the image uses them.
spike/
